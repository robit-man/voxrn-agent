{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "abi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "engine_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "model",
        "model_revision",
        "engine",
        "engine_revision"
      ],
      "additionalProperties": false
    },
    "state_schema": {
      "type": "object"
    },
    "initial_state": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "effect": {
            "type": "string",
            "enum": [
              "read_only",
              "record",
              "external"
            ]
          }
        },
        "required": [
          "id",
          "binding_id",
          "input_schema",
          "output_schema",
          "effect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bundle_version",
    "id",
    "revision",
    "source_sha256",
    "executable_sha256",
    "binding_set_sha256",
    "abi",
    "entrypoint",
    "identity",
    "state_schema",
    "initial_state",
    "operations"
  ],
  "additionalProperties": false
}
